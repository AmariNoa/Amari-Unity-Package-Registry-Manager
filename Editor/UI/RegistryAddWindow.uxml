<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="True">
    <Style src="RegistryCredentials.uss" />
    <ui:VisualElement class="registry-add-content">
        <ui:TextField name="registry-name-input" label="レジストリ名" class="compact-field" />
        <ui:TextField name="registry-url-input" label="URL" value="https://" class="compact-field" />
        <ui:VisualElement class="registry-add-actions">
            <ui:Button name="cancel-registry" text="キャンセル" />
            <ui:Button name="save-registry" text="登録" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
