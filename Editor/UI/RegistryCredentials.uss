.settings-content {
    flex-grow: 1;
    min-height: 0;
    padding-left: 10px;
    padding-right: 10px;
    padding-bottom: 8px;
}

.settings-title {
    font-size: 20px;
    -unity-font-style: bold;
    margin-top: 7px;
    margin-bottom: 1px;
}

.package-display-name {
    font-size: 10px;
    margin-left: 15px;
    margin-bottom: 5px;
}

.horizontal {
    flex-direction: row;
    align-items: center;
}

.wrap {
    flex-wrap: wrap;
}

.grow {
    flex-grow: 1;
}

.panes {
    flex-direction: row;
    align-items: stretch;
    flex-grow: 1;
    min-height: 0;
    margin-top: 4px;
}

.pane {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    min-height: 0;
    margin-left: 4px;
    margin-right: 4px;
}

.heading {
    -unity-font-style: bold;
    margin-top: 3px;
    margin-bottom: 3px;
}

.preview-list {
    height: 142px;
}

.list-footer Button {
    flex-shrink: 0;
    margin-right: 4px;
    margin-top: 2px;
    margin-bottom: 2px;
}

.details-scroll {
    flex-grow: 1;
    min-height: 0;
}

.details {
    padding-top: 5px;
    padding-left: 2px;
    padding-right: 2px;
    white-space: normal;
}

.wrapping {
    white-space: normal;
}

.preview-hidden {
    display: none;
}

.compact-field > .unity-base-field__label {
    width: 90px;
    min-width: 90px;
    max-width: 90px;
    flex-shrink: 0;
}

.list-row {
    flex-direction: row;
    padding-left: 4px;
    padding-right: 4px;
}

.row-text {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
}

.row-name {
    -unity-font-style: bold;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.row-url {
    font-size: 10px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

Button {
    flex-shrink: 0;
}

#registry-catalog-pane > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container {
    flex-grow: 1;
    flex-shrink: 0;
    min-height: 100%;
}

#registry-catalog-pane > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container > .heading {
    flex-shrink: 0;
}

#registry-list {
    height: auto;
    flex-basis: 0;
    flex-grow: 1;
}

.scope-row {
    flex-direction: row;
    align-items: center;
    margin-left: 15px;
    margin-right: 15px;
}

.scope-row > .scope-value {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.registry-split {
    flex-grow: 1;
    flex-shrink: 0;
    flex-basis: 0;
    min-height: 440px;
}

#registry-split > .registry-list-region,
#registry-details {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-height: 0;
    margin-top: 5px;
    margin-right: 5px;
    margin-bottom: 5px;
    margin-left: 5px;
}

.registry-section-gap {
    height: 10px;
    flex-shrink: 0;
}

#registry-details > .details {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

#registry-details > .details > * {
    flex-grow: 0;
    flex-shrink: 0;
}

.registry-auth-row {
    flex-direction: row;
    align-items: center;
}

#registry-detail-scopes {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: auto;
    min-height: 60px;
}

.registry-add-content {
    padding-top: 10px;
    padding-right: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
}

.registry-add-actions {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 10px;
}
